<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_music_item"
    android:gravity="center_vertical">

    <!-- Music icon with circle background -->
    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp">

        <ImageView
            android:id="@+id/iv_music_icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_music_icon_circle"
            android:src="@drawable/ic_music_note"
            android:padding="9dp"
            app:tint="@color/musicPrimary"
            android:contentDescription="Music icon" />
    </FrameLayout>

    <!-- Song info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/tv_music_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên bài hát"
            android:textSize="15sp"
            android:textColor="@color/textPrimary"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_music_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhạc mặc định"
            android:textSize="12sp"
            android:textColor="@color/textSecondary"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Play indicator -->
    <ImageView
        android:id="@+id/iv_play_indicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_play"
        app:tint="@color/musicPrimary"
        android:contentDescription="Play"
        android:visibility="gone" />

</LinearLayout>
